# Copy to .env (git-ignored) and fill in. `python -m dss` reads it; variables already set in the
# environment win, and empty values are skipped. Comments go on their own lines: everything after
# `=` is the value (a password may contain #). Never commit .env: it holds logins.

# Claude: the `claude` CLI logged in on this machine (run `claude` once). Nothing to set here.

# Cerberus checkout (DataDHPython) and its venv: cerb_client_info and cerb_read_sheet run in it.
# e.g. F:\git\DataDHPython\.venv\Scripts\python.exe and F:\git\DataDHPython
DSS_CERB_PY=
DSS_CERB_CWD=
# The bot's own Cerberus copies (`python -m dss cerberus` makes them; each triage updates them).
# DSS_CERB_GIT: its own clone, read by code_* and fetched before each triage; unset, code_* read
# the checkout above. DSS_CERB_PROD_CODE: where the prod wheel is unpacked, so cerb_client_info
# runs the Cerberus analysts installed; unset, it runs the checkout's.
# e.g. F:\git\dss-bot-cerberus\DataDHPython and F:\git\dss-bot-cerberus\prod
DSS_CERB_GIT=
DSS_CERB_PROD_CODE=
# The bot's own clone of MATLAB CAT (DataAnalysis), which Cerberus was ported from: read by
# matlab_* and fetched before each triage; `python -m dss cerberus` makes it, without files over
# 1 MB. Unset, the matlab tools are off. e.g. F:\git\dss-bot-cerberus\DataAnalysis
DSS_MATLAB_GIT=

# Project index (Everything HTTP server over the project share): the cerb_* project tools.
# Approved for read-only use on DSS tickets only. Sent as HTTP Basic auth over plain HTTP.
DV_PROJECT_INDEX_USER=
DV_PROJECT_INDEX_PASSWORD=
# optional; defaults http://192.168.25.120 and \\192.168.24.252\projects
DV_PROJECT_INDEX_URL=
DV_PROJECT_INDEX_ROOT=
# optional; the biggest file the tools copy from the share, in MB (default 1024)
DV_PROJECT_INDEX_MAX_MB=

# Cerberus release the analysts run. Optional: the prod wheel folder (default
# F:/DarkVision Dropbox/Analysis/CERBERUS/prod), and a commit to read instead of its release.
DV_CERB_PROD_DIR=
DV_CERB_REF=

# Confluence, read-only account: the confluence_* tools. URL is https://<site>.atlassian.net;
# SPACES is optional, e.g. DD,OPS.
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=

# Jira, read-only account: the jira_* tools. Leave empty to use the CONFLUENCE_* values (one
# Atlassian site and API token serve both).
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Slack app (ddev-support-bot): bot token xoxb-... and app-level token xapp-... (connections:write).
# The bot token alone lets `triage --thread` and `trial --thread` read a DSS ticket's thread
# (slack_thread); the live bot needs both, and somewhere to post. POST_CHANNEL is where analyses go
# (#data-dev-support-assist, C0CBE88LX0S; never #data-dev-support); without it they go to
# REVIEWER's DM (your member id: profile > Copy member ID). CHANNEL is the channel to watch
# (default #data-dev-support). TEST_CHANNEL is where `replay --post-test` posts (default
# #data-dev-support-assist-test, C0CF1J345EY).
DSS_SLACK_BOT_TOKEN=
DSS_SLACK_APP_TOKEN=
DSS_SLACK_POST_CHANNEL=
DSS_SLACK_REVIEWER=
DSS_SLACK_CHANNEL=
DSS_SLACK_TEST_CHANNEL=

# gh CLI for a replay's GitHub push history (GET only, your gh login); default gh on the PATH, else
# C:\Program Files\GitHub CLI\gh.exe
DSS_GH=

# 1: write each triage's tool calls to out/trace/<key>_<run time>.jsonl (client data; git-ignored)
DSS_TRACE=
