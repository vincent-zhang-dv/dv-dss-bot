# Copy to .env (git-ignored) and fill in. `python -m dss` reads it; variables already set in the
# environment win, and empty values are skipped. Comments go on their own lines: everything after
# `=` is the value (a password may contain #). Never commit .env: it holds logins.

# Claude: the `claude` CLI logged in on this machine (run `claude` once). Nothing to set here.

# Cerberus checkout (DataDHPython) and its venv: cerb_client_info and the code_* tools.
# Keep it fetched, so code_* can find new release commits on origin/master.
# e.g. F:\git\DataDHPython\.venv\Scripts\python.exe and F:\git\DataDHPython
DSS_CERB_PY=
DSS_CERB_CWD=

# Project index (Everything HTTP server over the project share): the cerb_* project tools.
# Approved for read-only use on DSS tickets only. Sent as HTTP Basic auth over plain HTTP.
DV_PROJECT_INDEX_USER=
DV_PROJECT_INDEX_PASSWORD=
# optional; defaults http://192.168.25.120 and \\192.168.24.252\projects
DV_PROJECT_INDEX_URL=
DV_PROJECT_INDEX_ROOT=

# Cerberus release the analysts run. Optional: the prod wheel folder (default
# F:/DarkVision Dropbox/Analysis/CERBERUS/prod), and a commit to read instead of its release.
DV_CERB_PROD_DIR=
DV_CERB_REF=

# Confluence, read-only account: the confluence_* tools. URL is https://<site>.atlassian.net;
# SPACES is optional, e.g. DD,OPS.
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=

# Jira, read-only account: the jira_* tools. Leave empty to use the CONFLUENCE_* values (one
# Atlassian site and API token serve both).
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Slack app made from slack_manifest.yaml (`python -m dss slack` only): bot token xoxb-...,
# app token xapp-..., and your Slack member id (profile > Copy member ID) for the DM.
# CHANNEL is optional (default #data-dev-support); set a test channel for a dev app.
DSS_SLACK_BOT_TOKEN=
DSS_SLACK_APP_TOKEN=
DSS_SLACK_REVIEWER=
DSS_SLACK_CHANNEL=
